    "background": "#F4EFE5",
    "foreground": "#24272B",
    "muted": "#596650",
    "accent": "#D96F59",
    "accent_foreground": "#24272B",
    "secondary": "#98A69A",
    "secondary_foreground": "#24272B",
    "highlight": "#D9AD4B",
    "highlight_foreground": "#24272B",
    "signal": "#9CCDD0",
    "signal_foreground": "#24272B"
  },
  "imagery": {
    "mode": "mixed",
    "treatment": "muted"
  }
}
