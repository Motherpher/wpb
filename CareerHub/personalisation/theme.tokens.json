{
  "schema_version": "1.0",
  "typography": {
    "display": "Iowan Old Style, Baskerville, Georgia, 'Times New Roman', serif",
    "body": "Avenir Next, Inter, ui-sans-serif, system-ui, sans-serif",
    "scale": "large"
  },
  "shape": {
    "radius": "square",
    "border": "defined"
  },
  "surface": {
    "treatment": "editorial",
    "shadow": "none"
  },
  "palette": {
    "background": "#F7F2E8",
    "foreground": "#242831",
    "muted": "#59675F",
    "accent": "#ED7938",
    "accent_foreground": "#242831"
  },
  "imagery": {
    "mode": "mixed",
    "treatment": "high-contrast"
  }
}
